# collect-ai S 端 (后端) 配置
# 部署到 Linux 服务器前, 复制为 .env 并填实际值

# 智谱 BigModel API Key (必填, 去 https://bigmodel.cn 申请)
BIGMODEL_API_KEY=your_key_here

# 公开 base URL, 用于生成飞书 H5 可访问的图片 URL
# 留空则图片只本地 (飞书 H5 看不到)
# 部署到公网时填 https://your-domain.com
PUBLIC_BASE_URL=

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=collectai

# 智谱模型
BIGMODEL_BASE=https://open.bigmodel.cn/api/paas/v4
OCR_MODEL=hand_write
LLM_MODEL=glm-4-flash

# cube-agent-server
AGENT_URL=http://127.0.0.1:8088
AGENT_TOKEN=

# 解析行为
OCR_TIMEOUT_SEC=60
LLM_TIMEOUT_SEC=180
USE_LLM=true
FUZZY_DISTANCE=2

# 限流
MAX_CONCURRENT_PARSE=4
RATE_LIMIT_WAIT_SEC=30

# ============== 鉴权 (2026-08-29) ==============
# JWT 签名密钥 (HS256, prod 必须 ≥32 字符且非默认)
JWT_SECRET=dev-secret-change-me-in-prod-32chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
# dev-login 开关 (生产务必设 false)
DEV_MODE=true
# 企微 OAuth (H5 免登) — corpSecret 严禁进前端
# 注: WECOM_BOT_ID 是 bot 长连接用的, 跟 OAuth 无关
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
COOKIE_DOMAIN=127.0.0.1
COOKIE_SECURE=false
